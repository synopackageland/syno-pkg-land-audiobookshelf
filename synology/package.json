{
  "name": "syno-pkg-land-audiobookshelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.mjs && npm run test:entry",
    "render": "python3 scripts/render-compose.py",
    "check": "synopkgland check --json",
    "build": "synopkgland build --arch x86_64 --json",
    "e2e:nas": "node tests/e2e/nas.ts",
    "test:entry": "cd tests/entry && go test -count=1 ./...",
    "e2e:smoke": "node tests/e2e/nas.ts tests/e2e/smoke.e2e.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.91",
    "@e2e-dev/web": "0.14.0",
    "@synopackageland/cli": "0.41.9",
    "@synopackageland/templates": "0.35.5",
    "ai": "7.0.137",
    "e2e": "0.19.0",
    "playwright": "1.63.0"
  }
}
